{{!
    @template tool_wizards/unlock_message

    A one-time message on a course page: newly unlocked activities, with an optional
    button that opens the matching mini-wizard (tool_wizards/first_content).

    Context variables required for this template:
    * courseid - the course being viewed
    * message - the message
    * try - {type (the wizard key), modaltitle, label} of the wizard to offer, or null

    Example context (json):
    {
        "courseid": 2,
        "message": "You've unlocked new activities: Quiz, Choice, Feedback.",
        "try": {"type": "quiz", "modaltitle": "Add a quiz",
            "label": "Try Quiz now"}
    }
}}
<section class="tool_wizards-unlock alert alert-success d-flex flex-wrap align-items-center gap-2 mb-4" role="status"
    data-region="tool_wizards-unlock" data-courseid="{{courseid}}" aria-label="{{#str}}unlock_heading, tool_wizards{{/str}}">
    <p class="mb-0 flex-grow-1">{{message}}</p>
    {{#try}}
    <button type="button" class="btn btn-primary" data-action="add" data-wizard="{{type}}"
        data-modaltitle="{{modaltitle}}">{{label}}</button>
    {{/try}}
    <button type="button" class="btn-close" data-action="done" aria-label="{{#str}}unlock_close, tool_wizards{{/str}}"></button>
</section>
