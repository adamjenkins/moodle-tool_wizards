{{!
    @template tool_wizards/first_content

    The first-content suggestions at the top of a course page. Each option opens a
    mini-wizard in a modal (tool_wizards/first_content). The card never blocks the page.

    Context variables required for this template:
    * courseid - the course
    * heading, question - what the card says
    * added - {name, url} of what was just added, or null
    * questionfailed - whether a quiz was added without the first question asked for
    * focus - whether to move focus to the card when the page loads
    * options - [{type (the wizard key), label, description, modaltitle, iconurl, purpose, modname, more (shown on request)}]
    * morecount - how many options wait behind "More kinds of content"
    * nextsteps - after an activity was added: [{type (an in-activity wizard key), cmid, label, modaltitle}]
    * preferencesurl - where the user can switch suggestions back on

    Example context (json):
    {
        "courseid": 2,
        "heading": "Your course is ready.",
        "question": "What would you like to add first?",
        "added": null,
        "questionfailed": false,
        "focus": true,
        "options": [{"type": "forum", "label": "A forum",
            "description": "A place for discussions.", "modaltitle": "Add a forum",
            "iconurl": "https://example.com/theme/image.php/boost/forum/1/monologo", "purpose": "collaboration",
            "modname": "forum", "more": false}],
        "morecount": 0,
        "nextsteps": [],
        "preferencesurl": "https://example.com/admin/tool/wizards/preferences.php"
    }
}}
<section class="tool_wizards-firstcontent card mb-4" data-region="tool_wizards-firstcontent" data-courseid="{{courseid}}"
    aria-labelledby="tool_wizards-firstcontent-heading"{{#focus}} data-focus="1"{{/focus}}>
    <div class="card-body">
        <div class="d-flex align-items-start gap-2">
            <div class="flex-grow-1">
                <h2 class="h4 card-title" id="tool_wizards-firstcontent-heading" tabindex="-1">{{heading}}</h2>
                {{#added}}{{#url}}
                <p class="mb-1"><a href="{{url}}">{{#str}}prompt_open, tool_wizards, {{name}}{{/str}}</a></p>
                {{/url}}{{/added}}
                {{#nextsteps.0}}
                <p class="mb-2">{{#str}}prompt_nextsteps, tool_wizards{{/str}}</p>
                <p class="d-flex flex-wrap gap-2 mb-3">
                    {{#nextsteps}}
                    <button type="button" class="btn btn-primary btn-sm" data-action="content" data-wizard="{{type}}"
                        data-cmid="{{cmid}}" data-modaltitle="{{modaltitle}}">{{label}}</button>
                    {{/nextsteps}}
                </p>
                {{/nextsteps.0}}
                {{#questionfailed}}
                <p class="mb-1">{{#str}}prompt_questionfailed, tool_wizards{{/str}}</p>
                {{/questionfailed}}
                <p class="mb-3">{{question}}</p>
            </div>
            <button type="button" class="btn-close" data-action="done" aria-label="{{#str}}prompt_done, tool_wizards{{/str}}"></button>
        </div>
        <ul class="tool_wizards-options list-unstyled row g-2 mb-3">
            {{#options}}
            <li class="col-12 col-sm-6 col-lg-4{{#more}} d-none{{/more}}"{{#more}} data-region="tool_wizards-more"{{/more}}>
                <button type="button" class="tool_wizards-option btn btn-outline-secondary w-100 h-100 text-start d-flex gap-3 align-items-start p-3"
                    data-action="add" data-wizard="{{type}}" data-modaltitle="{{modaltitle}}">
                    <span class="activity-icon activityiconcontainer {{purpose}} flex-shrink-0" aria-hidden="true">
                        <img src="{{iconurl}}" alt="" class="activityicon">
                    </span>
                    <span>
                        <span class="d-block fw-bold">{{label}}</span>
                        <span class="d-block small text-body-secondary" id="tool_wizards-option-{{type}}-desc">{{description}}</span>
                    </span>
                </button>
            </li>
            {{/options}}
        </ul>
        {{#morecount}}
        <p class="mb-3">
            <button type="button" class="btn btn-outline-primary btn-sm" data-action="more" aria-expanded="false">{{#str}}prompt_more, tool_wizards, {{morecount}}{{/str}}</button>
        </p>
        {{/morecount}}
        <div class="d-flex flex-wrap gap-3 align-items-center small">
            <button type="button" class="btn btn-link btn-sm p-0" data-action="done">{{#str}}prompt_done, tool_wizards{{/str}}</button>
            <button type="button" class="btn btn-link btn-sm p-0" data-action="dismisscourse">{{#str}}prompt_hidecourse, tool_wizards{{/str}}</button>
            <button type="button" class="btn btn-link btn-sm p-0" data-action="dismissall">{{#str}}prompt_hideall, tool_wizards{{/str}}</button>
        </div>
    </div>
</section>
