{{!
    @template tool_wizards/wizard_list

    The wizards a teacher can choose from after "Add with a wizard", each with its activity's
    icon (coloured by the activity's purpose, as in Moodle's activity chooser) and a line saying
    what it helps with.

    Context variables required for this template:
    * wizards - [{key, title, heading (the wizard's modal title), description, icon, purpose}]

    Example context (json):
    {
        "wizards": [
            {"key": "forum", "title": "A forum", "heading": "Add a forum", "description": "A place for discussions.",
             "icon": "https://example.com/theme/image.php/boost/forum/1/monologo", "purpose": "collaboration"},
            {"key": "quiz", "title": "A quiz", "heading": "Add a quiz", "description": "Check what students know.",
             "icon": "https://example.com/theme/image.php/boost/quiz/1/monologo", "purpose": "assessment"}
        ]
    }
}}
<div class="list-group tool_wizards-wizardlist">
    {{#wizards}}
    <button type="button" class="list-group-item list-group-item-action d-flex gap-3 align-items-center py-3"
        data-wizard="{{key}}" data-heading="{{heading}}">
        <span class="activity-icon activityiconcontainer {{purpose}} flex-shrink-0" aria-hidden="true">
            <img src="{{icon}}" class="activityicon" alt="">
        </span>
        <span>
            <span class="d-block fw-bold">{{title}}</span>
            {{#description}}<span class="d-block small text-body-secondary">{{description}}</span>{{/description}}
        </span>
    </button>
    {{/wizards}}
</div>
