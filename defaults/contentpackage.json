{
    "format": "tool_wizards/wizard@1",
    "key": "contentpackage",
    "defaultversion": 1,
    "target": {
        "type": "module",
        "modname": "imscp"
    },
    "title": {
        "string": "type_contentpackage"
    },
    "heading": {
        "string": "type_contentpackage_title"
