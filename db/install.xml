<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="admin/tool/wizards/db" VERSION="20261009" COMMENT="XMLDB file for Moodle admin/tool/wizards"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../../lib/xmldb/xmldb.xsd"
>
  <TABLES>
    <TABLE NAME="tool_wizards_dismissed" COMMENT="Courses where a user chose to hide the first-content suggestions">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="The user who hid the suggestions"/>
        <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="The course they are hidden for"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="userid" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
        <KEY NAME="courseid" TYPE="foreign" FIELDS="courseid" REFTABLE="course" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="userid-courseid" UNIQUE="true" FIELDS="userid, courseid"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="tool_wizards_message" COMMENT="Messages queued for a user, shown on their next course page view">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="The user the message is for"/>
        <FIELD NAME="type" TYPE="char" LENGTH="20" NOTNULL="true" SEQUENCE="false" COMMENT="Message kind, e.g. unlock"/>
        <FIELD NAME="payload" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="JSON data for the message"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timeshown" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="When the message was shown, null while still queued"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="userid" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="userid-timeshown" UNIQUE="false" FIELDS="userid, timeshown"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="tool_wizards_wizard" COMMENT="Wizard definitions: one JSON document per wizard, plus how it is offered and where it came from">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="wizardkey" TYPE="char" LENGTH="100" NOTNULL="true" SEQUENCE="false" COMMENT="Unique key, also the key inside the definition"/>
        <FIELD NAME="target" TYPE="char" LENGTH="60" NOTNULL="true" SEQUENCE="false" COMMENT="course, or the name of the module it adds"/>
        <FIELD NAME="status" TYPE="int" LENGTH="2" NOTNULL="true" DEFAULT="1" SEQUENCE="false" COMMENT="1 enabled, 0 disabled, 2 draft"/>
        <FIELD NAME="sortorder" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Order offered to teachers"/>
        <FIELD NAME="definition" TYPE="text" NOTNULL="true" SEQUENCE="false" COMMENT="The wizard definition, JSON"/>
        <FIELD NAME="origin" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="custom" SEQUENCE="false" COMMENT="default, custom or imported"/>
        <FIELD NAME="shippedversion" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="For a default: the shipped version installed"/>
        <FIELD NAME="shippedhash" TYPE="char" LENGTH="40" NOTNULL="false" SEQUENCE="false" COMMENT="For a default: hash of the definition as shipped"/>
        <FIELD NAME="newerversion" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="For an edited default: a newer shipped version waiting, 0 for none"/>
        <FIELD NAME="retired" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="For a default no longer shipped: 1"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="wizardkey" UNIQUE="true" FIELDS="wizardkey"/>
        <INDEX NAME="target-status" UNIQUE="false" FIELDS="target, status"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
